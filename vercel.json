{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix career_web ci && npm --prefix career_web run build",
  "env": {
    "AUTO_PTU_RUNTIME_ROOT": "/tmp",
    "AUTO_PTU_REPORTS_DIR": "/tmp/autoptu/reports",
    "AUTOPTU_BATTLE_LOG_DIR": "/tmp/autoptu/reports/battle_logs",
    "AUTO_PTU_SPRITE_DIR": "/tmp/autoptu/sprites",
    "AUTO_PTU_POKEAPI_CACHE": "/tmp/autoptu/pokeapi",
    "CAREER_BATTLE_EXECUTION": "inline"
  },
  "functions": {
    "app.py": {
      "excludeFiles": "{career_web/**,auto_ptu/api/static/**}"
    }
  }
}
